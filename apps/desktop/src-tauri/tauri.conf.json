{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumora",
  "version": "0.1.0",
  "identifier": "com.lumora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumora",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": []
  }
}
