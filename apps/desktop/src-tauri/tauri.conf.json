{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumora",
  "version": "0.1.0",
  "identifier": "com.lumora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lumora",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNEUxMDRBMDBBNjMzNjcKUldSbk02WUFTaEJPa2pKdVlQT0x6d1Q4cTZwM1Nnb3dLV0ZQeXVzSEdPbEw5WmZRVDVld3dNRE0K",
      "endpoints": [
        "https://github.com/luoleicn/lumora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libsecret-1-0"
        ],
        "desktopTemplate": "linux/lumora.desktop"
      }
    }
  }
}
