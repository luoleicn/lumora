generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  passwordSalt        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  papers              Paper[]
  fileAssets          FileAsset[]
  collections         Collection[]
  paperCollections    PaperCollection[]
  annotations         Annotation[]
  changes             Change[]
  externalConnections ExternalConnection[]
  importJobs          ImportJob[]
}

model Paper {
  id               String            @id
  userId           String
  title            String
  authors          Json
  year             Int?
  venue            String?
  doi              String?
  arxiv            String?
  pmid             String?
  abstract         String?
  source           String?
  documentType     String?
  tags             Json               @default("[]")
  keywords         Json               @default("[]")
  url              String?
  pages            String?
  volume           String?
  issue            String?
  publisher        String?
  favorite         Boolean           @default(false)
  needsReview      Boolean           @default(false)
  unread           Boolean           @default(true)
  createdAt        DateTime
  updatedAt        DateTime
  deletedAt        DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileAssets       FileAsset[]
  paperCollections PaperCollection[]
  annotations      Annotation[]

  @@index([userId, updatedAt])
  @@index([userId, doi])
  @@index([userId, arxiv])
  @@index([userId, pmid])
}

model FileAsset {
  id            String       @id
  userId        String
  paperId       String
  sha256        String
  size          Int
  mime          String
  fileName      String
  localPath     String?
  objectKey     String?
  downloadState String
  createdAt     DateTime
  updatedAt     DateTime
  deletedAt     DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper         Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  annotations   Annotation[]

  @@index([userId, sha256])
  @@index([userId, paperId])
}

model Collection {
  id               String            @id
  userId           String
  name             String
  parentId         String?
  sortOrder        Int               @default(0)
  createdAt        DateTime
  updatedAt        DateTime
  deletedAt        DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperCollections PaperCollection[]

  @@index([userId, parentId])
}

model PaperCollection {
  id           String     @id
  userId       String
  paperId      String
  collectionId String
  createdAt    DateTime
  updatedAt    DateTime
  deletedAt    DateTime?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper        Paper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId, collectionId])
  @@index([userId, collectionId])
}

model Annotation {
  id        String    @id
  userId    String
  paperId   String
  fileId    String
  pageIndex Int
  kind      String
  color     String
  rects     Json
  quote     String?
  comment   String?
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, paperId])
  @@index([userId, updatedAt])
}

model Change {
  id         Int      @id @default(autoincrement())
  userId     String
  entityType String
  entityId   String
  op         String
  changedAt  DateTime @default(now())
  clientId   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
}

model ExternalConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model ImportJob {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  status              String
  error               String?
  importedPapers      Int      @default(0)
  importedFiles       Int      @default(0)
  importedCollections Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}
